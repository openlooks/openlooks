{
  "name": "@openlooks/compiler",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsc && esbuild ./src/main.ts --bundle --packages=external --format=esm --outfile=./dist/main.mjs",
    "compile": "node --experimental-specifier-resolution=node --loader ts-node/esm src/main.ts"
  },
  "devDependencies": {
    "fast-glob": "3.3.3",
    "ts-node": "10.9.2"
  }
}
